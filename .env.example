# Hermes Agent + WebUI — Environment Variables
# Copy this to .env and fill in your values:
#   cp .env.example .env

# ═══════════════════════════════════════════════════════════════
# LLM Provider — set the key for whichever provider you use
# (only need the one(s) you actually use)
# ═══════════════════════════════════════════════════════════════
# ANTHROPIC_API_KEY=sk-ant-***
# OPENAI_API_KEY=sk-***
# OPENROUTER_API_KEY=sk-or-***
# GOOGLE_API_KEY=***
# DEEPSEEK_API_KEY=***

# ═══════════════════════════════════════════════════════════════
# Agent API server authentication
# ═══════════════════════════════════════════════════════════════
# The WebUI sends this token when talking to the agent's API server.
# Must match API_SERVER_KEY on the hermes-agent side.
# Generate a strong random string: openssl rand -hex 24
API_SERVER_KEY=your-secret-key

# ═══════════════════════════════════════════════════════════════
# WebUI access password
# ═══════════════════════════════════════════════════════════════
# REQUIRED if WebUI is exposed beyond loopback (e.g. port 3003).
HERMES_WEBUI_PASSWORD=your-password-here

# ═══════════════════════════════════════════════════════════════
# Optional: LLM endpoint override
# ═══════════════════════════════════════════════════════════════
# Only needed if your LLM is at a non-standard address.
# The agent container can reach the host via host.docker.internal.
# LLM_BASE_URL=http://host.docker.internal:11434/v1

# ═══════════════════════════════════════════════════════════════
# Optional: Git keys (forwarded into dev containers if used)
# ═══════════════════════════════════════════════════════════════
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_***

# ═══════════════════════════════════════════════════════════════
# Optional: Gateway allow-all (private LAN only)
# ═══════════════════════════════════════════════════════════════
# GATEWAY_ALLOW_ALL_USERS=true

# ═══════════════════════════════════════════════════════════════
# Optional: Bitwarden / Vaultwarden MCP server
# ═══════════════════════════════════════════════════════════════
# Used by the @bitwarden/mcp-server MCP entry in config.yaml.
# Get client credentials from your Vaultwarden instance:
#   Settings → My Account → scroll to "API Key" → View API Key
# BITWARDEN_BASE_URL=https://your-vault.example.com
# BW_CLIENTID=your.client.id
# BW_CLIENTSECRET=your-c...cret

# ═══════════════════════════════════════════════════════════════
# Optional: Tailscale (dev-container joins your tailnet)
# ═══════════════════════════════════════════════════════════════
# Generate a one-off auth key at https://login.tailscale.com/admin/settings/keys
# Without this, the dev-container can reach the host via compose networking
# but cannot reach other tailnet nodes.
# TAILSCALE_AUTH_KEY=tskey-auth-your-key-here
